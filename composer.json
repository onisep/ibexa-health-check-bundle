{
    "name": "onisep/ibexa-health-check-bundle",
    "type": "library",
    "version": "v3.0.0",
    "autoload": {
        "psr-4": {
            "Onisep\\IbexaHealthCheckBundle\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-client": "^7.3",
        "ibexa/solr": "^5.0",
        "guzzlehttp/promises": "^2.3",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.38",
        "ibexa/rector": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
